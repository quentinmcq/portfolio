# Served by Cloudflare Workers static assets (applies to assets only — the
# /api/* responses are generated by the worker).
#
# The script-src sha256 pins the inline theme/locale script in index.html:
# if that script changes, `bun run build` fails and prints the hash to paste here.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-jFFbTgEcRDo3CVvTuIj8q6btCOj8Oqa1KSa8MKS5BLE='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' wss://quentin-macq.dev; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
