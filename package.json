{
  "name": "portfolio",
  "version": "3.0.0",
  "private": true,
  "description": "Personal portfolio — Vue, TypeScript and Cloudflare Workers, prerendered at build time",
  "homepage": "https://quentin-macq.dev",
  "license": "MIT",
  "author": "Quentin Macq",
  "repository": "github:quentinmcq/portfolio",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && vp build --ssr src/entry-server.ts --outDir dist-server && bun scripts/prerender.ts",
    "preview": "vp preview",
    "og": "bun scripts/og.ts",
    "deploy": "wrangler deploy",
    "check": "vp check",
    "fmt": "vp check --fix",
    "lint": "vp lint --fix"
  },
  "dependencies": {
    "vue": "^3.6.0-rc.6",
    "vue-i18n": "^12.0.0-alpha.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "axe-core": "^4.13.0",
    "sass-embedded": "^1.103.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "packageManager": "bun@1.4.0"
}
