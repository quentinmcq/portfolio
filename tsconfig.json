  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["vite.config.*", "scripts/**/*", "src/**/*", "worker/**/*"],
  "compilerOptions": {
    "noUnusedLocals": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "vite-plus/client", "@cloudflare/workers-types"]
  }
}
