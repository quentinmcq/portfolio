{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "playwright.config.*",
    "scripts/**/*",
    "src/**/*",
    "tests/**/*",
    "vite.config.*",
    "worker/**/*"
  ],
  "compilerOptions": {
    "noUnusedLocals": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "vite-plus/client", "@cloudflare/workers-types"]
  }
}
